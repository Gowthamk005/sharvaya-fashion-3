{
  "name": "sharvaya-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Sharvaya Fashion API - Express + MongoDB (Mongoose), deployed as a Firebase Cloud Function",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "seed": "node --env-file-if-exists=.env scripts/seed-products.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "firebase-functions": "^7.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
